rules_version = '2';

/**
 * QUIZ PLATFORM — Firestore security rules (project embedx-assessment)
 *
 * Principle: deny everything by default. The API writes with a service account, which
 * bypasses these rules entirely, so client writes are almost always refused. Reads are
 * granted only to signed-in administrators with a role claim, and to a participant for
 * their own document once that account is bound to the record.
 *
 * What must never be client-readable: question answer keys (they live in SQLite and are
 * never mirrored), other participants' records, bulk certificate lists.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return isSignedIn() ? request.auth.token.role : null;
    }

    function isAdmin() {
      return role() in ['super_admin', 'quiz_admin', 'quiz_host', 'results_viewer'];
    }

    function canManage() {
      return role() in ['super_admin', 'quiz_admin'];
    }

    function isSuperAdmin() {
      return role() == 'super_admin';
    }

    // Administrators may read quiz metadata (never questions/options/answer keys).
    match /quizzes/{quizId} {
      allow read: if isAdmin();
      allow write: if false; // the API owns writes
    }

    // A participant may read their own record; staff may read all.
    match /participants/{participantId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /attempts/{attemptId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /certificates/{certificateId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /registrationFields/{fieldId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Operational trail: read-only for the principal administrator.
    match /auditLog/{entryId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Analytics / settings documents are server-only.
    match /settings/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
