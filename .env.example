# ---------------------------------------------------------------------------
# QUIZ PLATFORM — environment configuration (copy to .env, never commit .env)
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
APP_TIMEZONE=Asia/Kolkata
DATABASE_PATH=./data/quiz.db
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
DATA_DIR=./data

# Bootstrap administrator (created on first run if no user exists)
ADMIN_EMAIL=814725105014@trp.srmtrichy.edu.in
ADMIN_NAME=HARIHARAN V
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_ROLE=super_admin

# --- Google Workspace ------------------------------------------------------
# Provider modes:
#   mock            -> certificates/emails generated locally (development + testing)
#   apps_script     -> delegate to the Apps Script bridge (RECOMMENDED for production;
#                      reuses the existing certificate automation, no OAuth secrets in the app)
#   google_api      -> call Sheets/Slides/Drive/Gmail APIs directly via service account/OAuth
GOOGLE_PROVIDER=mock

# Shared with the Apps Script bridge (deployed from apps-script-bridge/)
APPS_SCRIPT_WEBHOOK_URL=
APPS_SCRIPT_SHARED_SECRET=

# google_api mode — service account with domain-wide delegation (impersonation)
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_IMPERSONATE_EMAIL=814725105014@trp.srmtrichy.edu.in

# google_api mode — OAuth refresh-token alternative
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Existing Google Workspace resources (audited) -------------------------
GOOGLE_SPREADSHEET_ID=1jiVDFpIxGwfSlHBt3vaHl-5GFd8DPGapSS4tsR-FhJQ
SHEET_RESPONSES_TAB=Form Responses 1
SHEET_RESULTS_TAB=Quiz Results
SHEET_LOG_TAB=Logs
CERT_TEMPLATE_ID=1dkfJ6PQtmeDEkcNR4xJWsWrLjSu5pkAnvY3JY44_ISo
CERT_OUTPUT_FOLDER_ID=1SDdCpIQHvf_WP0o9vC0ZrLHEb9vt0Q6Y
CERT_PREFIX=SRMTRP/EEE/VAC/
CERT_YEAR=2026
CERT_START_NUMBER=15
CERT_VERIFY_BASE_URL=http://localhost:4000/verify
CERT_EMAIL_FROM=814725105014@trp.srmtrichy.edu.in
CERT_EMAIL_FROM_NAME=SRM TRP Engineering College
# Optional text over the three signature lines; leave blank if the template already has signature images
CERT_SIGNATURE_COORDINATOR=
CERT_SIGNATURE_HOD=
CERT_SIGNATURE_PRINCIPAL=

# --- Firebase (Authentication + Firestore) ---------------------------------
# cookie   -> built-in scrypt + signed-cookie sessions (default; works with no Google access)
# firebase -> verify Firebase ID tokens (email/password, Google; phone once Blaze is on)
AUTH_MODE=cookie
FIREBASE_PROJECT_ID=embedx-assessment

# Public web-app identifiers (served to the browser via GET /api/public/runtime).
# These are not secrets: access is enforced by Firestore rules and server-side role checks.
FIREBASE_API_KEY=AIzaSyACO6JtEgvD_n5m5haPV-0y91Z76UI9C18
FIREBASE_AUTH_DOMAIN=embedx-assessment.firebaseapp.com
FIREBASE_STORAGE_BUCKET=embedx-assessment.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=803481654330
FIREBASE_APP_ID=1:803481654330:web:3bd07cd5cf42c4de1e5103
FIREBASE_MEASUREMENT_ID=G-S94VH65XXC

# Server credentials — NEVER commit these. Use one of:
#   FIREBASE_SERVICE_ACCOUNT_FILE=/etc/quiz/firebase-service-account.json
#   FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Mirror domain records into Firestore (SQLite stays the transactional source of truth)
FIRESTORE_MIRROR=false

# --- Safety ----------------------------------------------------------------
# true = every outbound email is redirected to ADMIN_EMAIL (bulk sending stays disabled)
EMAIL_TEST_MODE=true
EMAIL_REDIRECT_TO=814725105014@trp.srmtrichy.edu.in
# true = never call real Google APIs even if credentials exist
DRY_RUN=false
